# PERCKS Kidney Companion Environment Variables
# All health data is processed client-side and in the London region.

# Supabase (UK London Region - AWS eu-west-2)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# NHS Website Content API v2 (Syndication Key)
# https://digital.nhs.uk/developer/api-catalogue/nhs-website-content
NHS_CONTENT_API_KEY=your-nhs-content-api-key

# NHS Directory of Healthcare Services (Service Search) API v3
# https://digital.nhs.uk/developer/api-catalogue/directory-of-healthcare-services
NHS_DHS_API_KEY=your-nhs-dhs-api-key

# Feature Flags
VITE_FEATURE_CHATBOT=false
VITE_FEATURE_KFRE_CALCULATOR=true
VITE_FEATURE_COMMUNITY=true
VITE_FEATURE_UK_COSTING_INSIGHTS=true
